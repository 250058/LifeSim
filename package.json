{
  "name": "lifesim",
  "private": true,
  "version": "0.1.0",
  "description": "대한민국에서 태어났다 — 성인용 텍스트 인생 시뮬레이션",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "vite build --outDir dist-artifact && node tools/artifact/inline.mjs dist-artifact",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx tools/event-editor/validate.ts",
    "sim": "tsx tools/simulator/run.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.14",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
