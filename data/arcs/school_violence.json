      "weight": {
        "base": 0.05,
        "ageCurve": { "10": 1.5, "13": 1, "16": 0.4 },
        "modifiers": [{ "if": "hidden.morality < 40", "x": 1.5 }]
      },
      "limit": { "oncePerLife": true },
      "choices": [
        {
          "text": "웃는 이모티콘을 보낸다",
          "result": "다들 'ㅋㅋㅋ'를 쳤다. 그 아이는 다음 날 결석했다.",
          "effects": { "stats": { "morality": -6, "sociability": 2 }, "addFlags": ["bystander"] }
        },
        {
          "text": "주동자 편에 선다",
