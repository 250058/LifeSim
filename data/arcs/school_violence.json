          },
          "onFail": {
            "text": "가해자 측 변호사가 캡처의 앞뒤 맥락을 문제 삼았다. 서면사과 처분에 그쳤다.",
            "effects": {
              "removeFlags": ["bullying_active", "sv_evidence"],
              "stats": { "happiness": -4, "stress": -2 }
