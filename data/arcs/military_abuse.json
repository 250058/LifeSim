          { "if": "stats.sociability < 40", "x": 1.3 }
        ]
      },
      "limit": { "oncePerLife": true },
      "choices": [
        {
          "text": "전역할 때까지 참는다",
          "result": "달력에 X를 그었다. 매일 밤 남은 날짜를 셌다.",
          "effects": {
            "addFlags": ["hazing_victim"],
            "stats": { "mental": -10, "happiness": -10, "stress": 15, "health": -3 },
            "later": [{ "event": "mil_abuse_legacy", "inYears": 1 }]
