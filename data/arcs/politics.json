{
  "arc": "정치 → 대통령",
  "motif": "피선거권 국회의원·지방선거 18세, 대통령 40세 https://www.kyeonggi.com/article/202201031182113 · 정치인은 모두 가상 인물, 정당은 가상 정당",
  "events": [
    {
      "id": "political_offer",
      "type": "chain_start",
      "arc": "politics",
      "title": "공천 제안",
      "text": "{정당} 인재영입위원회에서 연락이 왔다. 다음 총선에 고향 {고향} 지역구로 나와 달라고 한다.",
      "tone": "drama",
      "impact": 25,
      "trigger": { "age": [30, 65], "notFlags": ["lawmaker", "criminal_record"], "if": "!legal.inPrison" },
      "weight": {
        "base": 0.00008,
        "modifiers": [
          { "if": "state.reputation > 60", "x": 4 },
          { "if": "found.leadership", "x": 2 },
          { "if": "job.id == 'lawyer' || job.id == 'doctor'", "x": 2 },
          { "if": "money.network > 60", "x": 2 },
          { "if": "flags.hazing_reported || flags.compound_survivor", "x": 1.5 }
        ]
      },
      "limit": { "oncePerLife": true },
      "choices": [
        {
          "text": "출마한다",
          "check": { "stats": ["reputation", "sociability"], "dc": 52 },
          "onSuccess": {
            "text": "개표 방송 새벽 2시, 당선 확정. 금배지를 달았다.",
            "effects": {
              "addFlags": ["lawmaker"],
              "stats": { "reputation": 20, "happiness": 10, "stress": 15 },
              "money": { "cash": -50000000, "network": 20 }
            }
          },
          "onFail": {
            "text": "2.1%포인트 차로 낙선했다. 득표율 15%를 넘겨 선거비용은 보전받았다.",
            "effects": {
              "stats": { "happiness": -8, "reputation": 5 },
              "money": { "cash": -20000000, "network": 10 }
            }
          }
        },
        { "text": "거절한다", "result": "정치는 TV로만 보기로 했다." }
      ]
    },
    {
      "id": "presidential_run",
      "type": "consequence",
      "arc": "politics",
      "title": "대선 출마",
      "text": "당내 경선 여론조사에서 내 이름이 1위로 올라왔다. 지지자들이 출마 선언문 초안을 들고 왔다.",
      "tone": "drama",
      "impact": 40,
      "trigger": {
        "age": [40, 80],
        "flags": ["lawmaker"],
        "notFlags": ["president"],
        "if": "world.electionYear && !legal.inPrison"
      },
      "weight": {
        "base": 0.12,
        "modifiers": [{ "if": "state.reputation > 70", "x": 2 }, { "if": "found.leadership", "x": 1.5 }]
      },
      "limit": { "max": 2 },
      "choices": [
        {
          "text": "출마를 선언한다",
          "check": { "stats": ["reputation", "sociability", "intelligence"], "dc": 70 },
          "onSuccess": {
            "text": "득표율 48.6%. 5년 단임. 이제 이 나라가 내 책임이다.",
            "effects": {
              "addFlags": ["president"],
              "stats": { "reputation": 30, "stress": 25, "happiness": 10 }
            }
          },
          "onFail": {
            "text": "경선에서 졌다. 승자의 손을 들어 줬다.",
            "effects": { "stats": { "happiness": -10, "reputation": 3 } }
          }
        },
        { "text": "다음을 기약한다", "result": "아직은 때가 아니라고 생각했다." }
      ]
    }
  ]
}
